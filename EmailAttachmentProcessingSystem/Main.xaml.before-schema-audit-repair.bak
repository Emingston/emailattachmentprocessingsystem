<Activity mc:Ignorable="sap sap2010" x:Class="Main" VisualBasic.Settings="{x:Null}" xmlns="http://schemas.microsoft.com/netfx/2009/xaml/activities" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:sap="http://schemas.microsoft.com/netfx/2009/xaml/activities/presentation" xmlns:sap2010="http://schemas.microsoft.com/netfx/2009/xaml/activities/presentation" xmlns:scg="clr-namespace:System.Collections.Generic;assembly=System.Private.CoreLib" xmlns:sco="clr-namespace:System.Collections.ObjectModel;assembly=System.Private.CoreLib" xmlns:uga="clr-namespace:UiPath.GSuite.Activities;assembly=UiPath.GSuite.Activities" xmlns:ugae="clr-namespace:UiPath.GSuite.Activities.Enums;assembly=UiPath.GSuite.Activities" xmlns:ugage="clr-namespace:UiPath.GSuite.Activities.Gmail.Enums;assembly=UiPath.GSuite.Activities" xmlns:ugagm="clr-namespace:UiPath.GSuite.Activities.Gmail.Models;assembly=UiPath.GSuite.Activities" xmlns:ugm="clr-namespace:UiPath.GSuite.Models;assembly=UiPath.GSuite" xmlns:ui="http://schemas.uipath.com/workflow/activities" xmlns:usau="clr-namespace:UiPath.Shared.Activities.Utils;assembly=UiPath.GSuite.Activities" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:excel="clr-namespace:UiPath.Excel.Activities;assembly=UiPath.Excel.Activities" xmlns:sys="clr-namespace:System;assembly=System.Private.CoreLib" xmlns:sysio="clr-namespace:System.IO;assembly=System.Private.CoreLib" xmlns:dt="clr-namespace:System.Data;assembly=System.Data.Common">
  <TextExpression.NamespacesForImplementation>
    <sco:Collection x:TypeArguments="x:String">
      <x:String>System</x:String><x:String>System.IO</x:String><x:String>System.Data</x:String><x:String>System.Linq</x:String><x:String>System.Collections.Generic</x:String><x:String>System.Activities</x:String><x:String>System.Activities.Statements</x:String><x:String>Microsoft.VisualBasic</x:String><x:String>UiPath.Core</x:String><x:String>UiPath.Core.Activities</x:String><x:String>UiPath.GSuite.Activities</x:String><x:String>UiPath.GSuite.Models</x:String><x:String>UiPath.Excel.Activities</x:String>
    </sco:Collection>
  </TextExpression.NamespacesForImplementation>
  <TextExpression.ReferencesForImplementation>
    <sco:Collection x:TypeArguments="AssemblyReference">
      <AssemblyReference>System.Activities</AssemblyReference><AssemblyReference>Microsoft.VisualBasic</AssemblyReference><AssemblyReference>System.Private.CoreLib</AssemblyReference><AssemblyReference>System.Data</AssemblyReference><AssemblyReference>System.Data.Common</AssemblyReference><AssemblyReference>System</AssemblyReference><AssemblyReference>UiPath.System.Activities</AssemblyReference><AssemblyReference>UiPath.GSuite.Activities</AssemblyReference><AssemblyReference>UiPath.GSuite</AssemblyReference><AssemblyReference>UiPath.Excel.Activities</AssemblyReference>
    </sco:Collection>
  </TextExpression.ReferencesForImplementation>
  <Sequence DisplayName="Email Attachment Processing" sap2010:WorkflowViewState.IdRef="Sequence_Main">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:String" Name="inputAttachments" /><Variable x:TypeArguments="x:String" Name="processedFolder" /><Variable x:TypeArguments="x:String" Name="errorFolder" /><Variable x:TypeArguments="x:String" Name="outputFolder" /><Variable x:TypeArguments="x:String" Name="reportPath" /><Variable x:TypeArguments="x:String" Name="logPath" /><Variable x:TypeArguments="dt:DataTable" Name="currentData" /><Variable x:TypeArguments="x:Boolean" Name="emailSucceeded" /><Variable x:TypeArguments="x:Boolean" Name="reportExists" /><Variable x:TypeArguments="x:Boolean" Name="logExists" /><Variable x:TypeArguments="x:String" Name="failureText" />
    </Sequence.Variables>
    <Assign DisplayName="Set Input Attachments Folder"><Assign.To><OutArgument x:TypeArguments="x:String">[inputAttachments]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:String">[System.IO.Path.Combine(Environment.CurrentDirectory, "Input", "Attachments")]</InArgument></Assign.Value></Assign>
    <Assign DisplayName="Set Processed Folder"><Assign.To><OutArgument x:TypeArguments="x:String">[processedFolder]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:String">[System.IO.Path.Combine(Environment.CurrentDirectory, "Processed")]</InArgument></Assign.Value></Assign>
    <Assign DisplayName="Set Error Folder"><Assign.To><OutArgument x:TypeArguments="x:String">[errorFolder]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:String">[System.IO.Path.Combine(Environment.CurrentDirectory, "Error")]</InArgument></Assign.Value></Assign>
    <Assign DisplayName="Set Output Folder"><Assign.To><OutArgument x:TypeArguments="x:String">[outputFolder]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:String">[System.IO.Path.Combine(Environment.CurrentDirectory, "Output")]</InArgument></Assign.Value></Assign>
    <Assign DisplayName="Set Report Path"><Assign.To><OutArgument x:TypeArguments="x:String">[reportPath]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:String">[System.IO.Path.Combine(outputFolder, "Processed_Report.xlsx")]</InArgument></Assign.Value></Assign>
    <Assign DisplayName="Set Log Path"><Assign.To><OutArgument x:TypeArguments="x:String">[logPath]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:String">[System.IO.Path.Combine(outputFolder, "Processing_Log.csv")]</InArgument></Assign.Value></Assign>
    <ui:CreateDirectory DisplayName="Create Input Attachments Folder" Path="[inputAttachments]" /><ui:CreateDirectory DisplayName="Create Processed Folder" Path="[processedFolder]" /><ui:CreateDirectory DisplayName="Create Error Folder" Path="[errorFolder]" /><ui:CreateDirectory DisplayName="Create Output Folder" Path="[outputFolder]" />
    <ui:FileExistsX DisplayName="Check Report" Path="[reportPath]" Exists="[reportExists]" />
    <If DisplayName="Create Report When Missing" Condition="[Not reportExists]"><If.Then><excel:CreateNewWorkbook DisplayName="Create Processed Report" WorkbookPath="[reportPath]" SheetName="ProcessedData" ConflictResolution="Skip" /></If.Then></If>
    <ui:FileExistsX DisplayName="Check Processing Log" Path="[logPath]" Exists="[logExists]" />
    <If DisplayName="Create Log Header When Needed" Condition="[Not logExists]"><If.Then><ui:AppendLine DisplayName="Write Log Header" FileName="[logPath]" Text="&quot;Subject&quot;,&quot;Filename&quot;,&quot;Status&quot;,&quot;Error&quot;" Encoding="utf-8" /></If.Then></If>
    <uga:ForEachEmailConnections ConnectionAccountName="{x:Null}" CurrentIndex="{x:Null}" Filter="{x:Null}" FolderIdBackup="{x:Reference __ReferenceID0}" Length="{x:Null}" ManualEntryFolder="{x:Null}" QueryFilter="{x:Null}" AllLabels="W3siSWQiOiJDSEFUIiwiTmFtZSI6IkNIQVQiLCJUeXBlIjoic3lzdGVtIn0seyJJZCI6IlNFTlQiLCJOYW1lIjoiU0VOVCIsIlR5cGUiOiJzeXN0ZW0ifSx7IklkIjoiSU5CT1giLCJOYW1lIjoiSU5CT1giLCJUeXBlIjoic3lzdGVtIn0=" AuthScopesInvalid="False" BrowserFolder="Inbox" BrowserFolderLabelId="INBOX" ConnectionId="31901571-4873-402e-adde-b12003b60eb1" CurrentItemVariableName="CurrentEmail" DisplayName="For Each Email" FilterSelectionMode="ConditionBuilder" FolderInputSelectionMode="Browse" ImportantOnly="False" IncludeAttachmentsMode="[UiPath.GSuite.Activities.Gmail.Enums.IncludeAttachmentsMode.All]" IncludeSubfolders="False" MarkAsRead="False" MaxResults="100" StarredOnly="False" UnreadOnly="True" UseConnectionService="True" WithAttachmentsOnly="True">
      <uga:ForEachEmailConnections.Body><ActivityAction x:TypeArguments="ugm:GmailMessage, x:Int32"><ActivityAction.Argument1><DelegateInArgument x:TypeArguments="ugm:GmailMessage" Name="CurrentEmail" /></ActivityAction.Argument1><ActivityAction.Argument2><DelegateInArgument x:TypeArguments="x:Int32" Name="CurrentEmailIndex" /></ActivityAction.Argument2><Sequence DisplayName="Do">
        <Assign DisplayName="Assume Email Succeeds"><Assign.To><OutArgument x:TypeArguments="x:Boolean">[emailSucceeded]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:Boolean">[True]</InArgument></Assign.Value></Assign>
        <TryCatch DisplayName="Download Attachments"><TryCatch.Try><uga:DownloadAttachmentsConnections ConnectionAccountName="{x:Null}" ContinueOnError="{x:Null}" Filter="{x:Null}" NewResult="{x:Null}" AuthScopesInvalid="False" ConflictResolution="Rename" ConnectionId="31901571-4873-402e-adde-b12003b60eb1" DestinationPath="[inputAttachments]" DisplayName="Download Email Attachments" Email="[CurrentEmail]" ExcludeInlineAttachments="True" FilterByFileNames="*.xlsx|*.xls" SearchMode="UseSimple" UseConnectionService="True" /></TryCatch.Try><TryCatch.Catches><Catch x:TypeArguments="sys:Exception"><ActivityAction x:TypeArguments="sys:Exception"><ActivityAction.Argument><DelegateInArgument x:TypeArguments="sys:Exception" Name="exception" /></ActivityAction.Argument><Sequence><Assign DisplayName="Record Download Failure"><Assign.To><OutArgument x:TypeArguments="x:Boolean">[emailSucceeded]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:Boolean">[False]</InArgument></Assign.Value></Assign><ui:AppendLine DisplayName="Log Download Failure" FileName="[logPath]" Text="[&quot;&quot;&quot;&quot; &amp; CurrentEmail.Subject.Replace(&quot;&quot;&quot;&quot;, &quot;&quot;&quot;&quot;&quot;&quot;) &amp; &quot;&quot;&quot;,,Failed,&quot;&quot;&quot; &amp; exception.Message.Replace(&quot;&quot;&quot;&quot;, &quot;&quot;&quot;&quot;&quot;&quot;) &amp; &quot;&quot;&quot;&quot;]" Encoding="utf-8" /></Sequence></ActivityAction></Catch></TryCatch.Catches></TryCatch>
        <If DisplayName="Process Attachments Only After Download" Condition="[emailSucceeded]"><If.Then><ui:ForEachFileX DisplayName="Process Downloaded Excel Files" Folder="[inputAttachments]" Filter="*.xls*" IncludeSubDirectories="False" OrderBy="NameAscFirst"><ui:ForEachFileX.Body><ActivityAction x:TypeArguments="sysio:FileInfo, x:Int32"><ActivityAction.Argument1><DelegateInArgument x:TypeArguments="sysio:FileInfo" Name="CurrentFile" /></ActivityAction.Argument1><ActivityAction.Argument2><DelegateInArgument x:TypeArguments="x:Int32" Name="CurrentFileIndex" /></ActivityAction.Argument2><TryCatch DisplayName="Validate and Consolidate File"><TryCatch.Try><Sequence><Assign DisplayName="Reset Data Table"><Assign.To><OutArgument x:TypeArguments="dt:DataTable">[currentData]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="dt:DataTable">[Nothing]</InArgument></Assign.Value></Assign><excel:ReadRange DisplayName="Read Excel Data" WorkbookPath="[CurrentFile.FullName]" SheetName="Sheet1" Range="A1" AddHeaders="True" DataTable="[currentData]" /><If DisplayName="Validate Data Table" Condition="[currentData IsNot Nothing AndAlso currentData.Rows.Count &gt; 0]"><If.Then><Sequence><excel:AppendRange DisplayName="Append Data to Report" WorkbookPath="[reportPath]" SheetName="ProcessedData" DataTable="[currentData]" /><ui:AppendLine DisplayName="Log Success" FileName="[logPath]" Text="[&quot;&quot;&quot;&quot; &amp; CurrentEmail.Subject.Replace(&quot;&quot;&quot;&quot;, &quot;&quot;&quot;&quot;&quot;&quot;) &amp; &quot;&quot;&quot;,&quot;&quot;&quot; &amp; CurrentFile.Name.Replace(&quot;&quot;&quot;&quot;, &quot;&quot;&quot;&quot;&quot;&quot;) &amp; &quot;&quot;&quot;,Success,&quot;&quot;&quot;&quot;]" Encoding="utf-8" /><ui:MoveFile DisplayName="Move Successful File" Path="[CurrentFile.FullName]" Destination="[processedFolder]" Overwrite="False" /></Sequence></If.Then><If.Else><Throw DisplayName="Invalid or Empty Workbook" Exception="[New System.Exception(&quot;Workbook is empty or contains no readable rows.&quot;)]" /></If.Else></If></Sequence></TryCatch.Try><TryCatch.Catches><Catch x:TypeArguments="sys:Exception"><ActivityAction x:TypeArguments="sys:Exception"><ActivityAction.Argument><DelegateInArgument x:TypeArguments="sys:Exception" Name="exception" /></ActivityAction.Argument><Sequence><Assign DisplayName="Record File Failure"><Assign.To><OutArgument x:TypeArguments="x:Boolean">[emailSucceeded]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:Boolean">[False]</InArgument></Assign.Value></Assign><Assign DisplayName="Capture Error"><Assign.To><OutArgument x:TypeArguments="x:String">[failureText]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:String">[exception.Message]</InArgument></Assign.Value></Assign><ui:AppendLine DisplayName="Log Failure" FileName="[logPath]" Text="[&quot;&quot;&quot;&quot; &amp; CurrentEmail.Subject.Replace(&quot;&quot;&quot;&quot;, &quot;&quot;&quot;&quot;&quot;&quot;) &amp; &quot;&quot;&quot;,&quot;&quot;&quot; &amp; CurrentFile.Name.Replace(&quot;&quot;&quot;&quot;, &quot;&quot;&quot;&quot;&quot;&quot;) &amp; &quot;&quot;&quot;,Failed,&quot;&quot;&quot; &amp; failureText.Replace(&quot;&quot;&quot;&quot;, &quot;&quot;&quot;&quot;&quot;&quot;) &amp; &quot;&quot;&quot;&quot;]" Encoding="utf-8" /><ui:MoveFile DisplayName="Move Failed File" Path="[CurrentFile.FullName]" Destination="[errorFolder]" Overwrite="False" ContinueOnError="True" /></Sequence></ActivityAction></Catch></TryCatch.Catches></TryCatch></ActivityAction></ui:ForEachFileX.Body></ui:ForEachFileX></If.Then></If>
        <If DisplayName="Mark Email Read After Complete Success" Condition="[emailSucceeded]"><If.Then><uga:MarkAsReadUnreadConnections DisplayName="Mark Current Email Read" ConnectionId="31901571-4873-402e-adde-b12003b60eb1" Email="[CurrentEmail]" MarkAs="Read" /></If.Then></If>
      </Sequence></ActivityAction></uga:ForEachEmailConnections.Body>
      <uga:ForEachEmailConnections.FilterSelectionBackup><usau:BackupSlot x:TypeArguments="ugae:FilterMode" StoredValue="ConditionBuilder"><usau:BackupSlot.BackupValues><scg:Dictionary x:TypeArguments="ugae:FilterMode, scg:List(x:Object)" /></usau:BackupSlot.BackupValues></usau:BackupSlot></uga:ForEachEmailConnections.FilterSelectionBackup>
      <uga:ForEachEmailConnections.Folder><ugagm:FolderArgument ConnectionDescriptor="{x:Null}" ManualEntryFolderName="{x:Null}" BrowserFolderId="INBOX" BrowserFolderName="Inbox" ConnectionKey="31901571-4873-402e-adde-b12003b60eb1" InputMode="Browse"><ugagm:FolderArgument.Backup><usau:BackupSlot x:TypeArguments="ugage:FolderInputMode" x:Name="__ReferenceID0" StoredValue="Browse"><usau:BackupSlot.BackupValues><scg:Dictionary x:TypeArguments="ugage:FolderInputMode, scg:List(x:Object)" /></usau:BackupSlot.BackupValues></usau:BackupSlot></ugagm:FolderArgument.Backup></ugagm:FolderArgument></uga:ForEachEmailConnections.Folder>
    </uga:ForEachEmailConnections>
  </Sequence>
</Activity>